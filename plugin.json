{
  "name": "歌单导入器",
  "version": "1.8.5",
  "description": "识别市面音乐软件分享歌单，导入至 Songloft 或通过洛雪音源下载",
  "author": "0klaus0",
  "license": "Apache-2.0",
  "entryPath": "playlist-importer",
  "main": "main.js",
  "permissions": [
    "storage",
    "persistent-storage",
    "songs.read",
    "songs.write",
    "playlists.read",
    "playlists.write",
    "fs:music",
    "fs",
    "jsenv"
  ],
  "publicPaths": ["/api"],
  "icon": "icon.jpg",
  "renderEngine": "webview"
}
